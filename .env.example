# ─── SkillUp — Environment Variables ─────────────────────────────────────────
# Copy to .env:  cp .env.example .env

PORT=5000

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI / Groq ────────────────────────────────────────────────────────────────
# Free key: https://console.groq.com/keys
# Leave blank to run in demo mode (clearly-labelled placeholder replies).
AI_API_KEY=
AI_MODEL=groq/compound-mini

# ── GitHub activity feed (optional) ──────────────────────────────────────────
# Set a repo to pull real commits/PRs/issues. Unset = seeded demo rows.
GITHUB_REPO=
# Optional token to raise the rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# ── CORS (optional) ──────────────────────────────────────────────────────────
# The frontend is same-origin by default, so leave blank unless you host the
# UI separately. Comma-separated list of allowed origins.
CORS_ORIGIN=
